.game-shell { position: relative; margin: 0 auto; overflow: hidden; background: #172020; }
.game-canvas { position: absolute; top: 0; left: 0; }
.hud { position: absolute; left: 16px; right: 16px; z-index: 2; }
.hud-top, .hud-row { display: flex; align-items: center; justify-content: space-between; }
.hud-top { margin-bottom: 10px; }
.brand { font-size: 17px; color: #edf1da; font-weight: bold; }
.clock { font-size: 21px; color: #d7e7ae; }
.small-button { padding: 7px 10px; border-radius: 5px; background: #31413f; font-size: 12px; }
.hud-row { font-size: 12px; color: #cdd7ca; margin: 6px 0; }
.muted { color: #a6b5ab; }
.meter { height: 5px; overflow: hidden; background: #38433b; border-radius: 3px; }
.hp-fill { height: 100%; background: #b8cf77; }
.xp-meter { height: 3px; }
.xp-fill { height: 100%; background: #7aafb0; }
.controls { position: absolute; left: 16px; right: 16px; z-index: 2; }
.status-line { font-size: 11px; text-align: center; color: #b7c5b2; margin-bottom: 10px; }
.movement-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.joystick { width: 108px; height: 108px; border-radius: 54px; border: 1px solid #71847b; background: rgba(35, 50, 47, .8); display: flex; justify-content: center; align-items: center; overflow: visible; }
.stick-knob { width: 40px; height: 40px; border-radius: 20px; background: #788d7b; border: 2px solid #b6c5a9; }
.movement-hint { color: #82988b; font-size: 11px; text-align: right; }
.skill-groups { display: flex; gap: 8px; }
.skill-group { min-width: 0; flex: 2; }
.skill-group.core { flex: 3; }
.group-label { font-size: 9px; color: #8fa294; text-align: center; margin-bottom: 5px; }
.skill-slots { display: flex; gap: 4px; }
.skill-slot { min-width: 0; flex: 1; padding: 5px 0; text-align: center; border-radius: 5px; background: #263734; border: 1px solid #4d6454; }
.slot-icon { font-size: 16px; color: #d2ddac; }
.slot-level { font-size: 7px; color: #a8bbad; margin-top: 3px; }
.skill-slot.fixed { border-color: #a7ab74; }
.skill-slot.core { border-color: #798c67; }
.skill-slot.boost { border-color: #5d8985; }
.skill-slot.empty { border-color: #354841; background: rgba(28, 43, 39, .65); }
.skill-slot.empty .slot-icon { color: #60746a; }
.skill-slot.empty .slot-level { color: #60746a; }
.overlay { position: absolute; inset: 0; z-index: 8; background: #121b1c; display: flex; align-items: center; justify-content: center; padding: 24px 18px; box-sizing: border-box; }
.modal { width: 100%; padding: 23px 20px; border: 1px solid #53634f; border-radius: 12px; background: #1e2b29; box-sizing: border-box; }
.eyebrow { display: block; font-size: 10px; letter-spacing: 2px; color: #90a887; margin-bottom: 12px; }
.modal-title { display: block; font-size: 25px; font-weight: bold; color: #e5efcb; margin-bottom: 10px; }
.modal-subtitle { display: block; font-size: 12px; line-height: 1.7; color: #b2c3b2; margin-bottom: 18px; }
.fixed-build { display: flex; justify-content: space-around; gap: 8px; font-size: 12px; color: #d1ddb4; padding: 12px 8px; border-radius: 5px; background: #334039; margin-bottom: 16px; }
.start-rule { margin-bottom: 24px; }
.rule-title { display: block; font-size: 13px; color: #dde8c6; margin-bottom: 7px; }
.choice-name { display: block; font-size: 13px; color: #dde8c6; }
.choice-description { display: block; font-size: 11px; line-height: 1.6; margin-top: 4px; color: #a2b9a8; }
.primary, .secondary { margin: 0; min-height: 42px; line-height: 42px; border-radius: 6px; }
.primary { flex: 1; background: #c3d78e; color: #203026; font-weight: bold; }
.secondary { background: #35473f; color: #cad7b7; padding: 0 16px; }
.upgrade-choice { padding: 17px 12px; border: 1px solid #789165; border-radius: 7px; margin-top: 12px; }
.upgrade-choice.boost { border-color: #648c86; }
.choice-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.choice-action { font-size: 10px; color: #a2b9a8; }
.choice-action.new { color: #d9ed9c; }
.choice-stars { font-size: 12px; letter-spacing: 1px; color: #d3df99; }
.compact { text-align: center; }
.compact .primary { width: 100%; }
.wide { width: 100%; margin-top: 10px; }
.admin-toggle { position: absolute; right: 16px; background: #3e5144; border-radius: 5px; padding: 7px 11px; font-size: 11px; z-index: 5; }
.admin-panel { position: absolute; left: 16px; right: 16px; z-index: 6; background: #172924; border: 1px solid #789c71; border-radius: 7px; padding: 11px; }
.admin-title { font-size: 12px; color: #d9e9b4; margin-bottom: 7px; }
.admin-stat { font-size: 10px; line-height: 1.8; color: #a6c3ac; }
.admin-buttons { display: flex; flex-wrap: wrap; margin: 7px 0; }
.admin-action { flex: 0 0 30%; padding: 7px 0; margin: 3px 1%; text-align: center; background: #334c3d; color: #d7e7c1; font-size: 10px; border-radius: 3px; }
.admin-log { max-height: 64px; overflow: hidden; white-space: pre-wrap; color: #8eab96; font-size: 9px; line-height: 1.5; }
@media (max-height: 690px) { .modal { padding: 16px; } .modal-subtitle { margin-bottom: 12px; } .joystick { width: 94px; height: 94px; } .skill-slot { padding: 4px 0; } .upgrade-choice { padding: 12px; } }
